# Copy this file to .env before running `docker compose up`.
# docker compose automatically loads a file named ".env" in the same
# directory as docker-compose.yml.

# ---- Database ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---- JWT ----
# MUST be identical across every service (they all verify tokens signed
# with this same secret) — that's why it's set once here and referenced
# by every service block in docker-compose.yml, rather than duplicated.
# Generate a strong one for anything beyond local/demo use, e.g.:
#   openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B59
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ---- Payment (dummy gateway) ----
# Fraction of charges that randomly "decline" to simulate a real
# processor's intermittent failures (0.05 = 5%). Any amount ending in
# .13 always declines, regardless of this setting — a deterministic way
# to demo the failure path.
PAYMENT_RANDOM_FAILURE_RATE=0.05
